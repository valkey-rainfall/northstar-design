From 71455f1c126252f9b16a6e8af78d1e19c267573c Mon Sep 17 00:00:00 2001
From: Rain Valentine <rsg000@gmail.com>
Date: Wed, 11 Nov 2026 02:05:26 +0000
Subject: [PATCH] Staged checks: count STREAM-path execution, add a STREAM
 difftest

STAGED_CHECKS builds count, on main, the write steps that ran the STREAM
executor (fastpathStagedExecuteStreaming), those with runs from two or
more IO threads, the client runs and entries executed there, and the runs
the window cut. INFO fastpath shows them as staged_check_stream_*, and
finishShutdown logs one line with the totals, so Tcl suites run with
--dont-clean leave the count in each server's log. Release builds are
unchanged.

FastpathDifftest.StreamExecutorMatchesPlainOverRandomPrograms runs each
random program with the STREAM executor (window 16, and window 2 so runs
are cut) and compares every reply byte and the final dataset with the
plain executor. With one IO thread the STREAM order equals the batch
order, so the plain executor is the oracle.

Signed-off-by: Rain Valentine <rsg000@gmail.com>
---
 src/fastpath.c                      | 35 +++++++++++++++++
 src/server.c                        |  3 ++
 src/server.h                        |  2 +
 src/unit/test_fastpath_difftest.cpp | 60 +++++++++++++++++++++++++++--
 4 files changed, 97 insertions(+), 3 deletions(-)

diff --git a/src/fastpath.c b/src/fastpath.c
index e1031010e..0155842e5 100644
--- a/src/fastpath.c
+++ b/src/fastpath.c
@@ -1805,6 +1805,9 @@ void fastpathInfo(sds *info) {
                          fastpath_clients + (fp_handback_client != NULL), stagedWorkerCount(), server.keyspace_shard_bits, reads, writes, batches,
                          speculated, in, out, fp_stat_lane_phases, fp_stat_lane_entries, fp_stat_barriers,
                          fp_stat_serial_segments, fp_stat_lane_prefetches);
+#ifdef STAGED_CHECKS
+    fastpathCheckStreamInfo(info);
+#endif
 }
 
 /* ---------------------------------------------------------------------------------------------
@@ -3163,6 +3166,29 @@ static cmdBatch *fpStreamRunAt(fpThread *t, fpStreamCursor *c, int d) {
  * The caller publishes b->executed at chunk granularity (always on a run boundary, since a run runs
  * whole), so a STREAM worker that reads executed with acquire sees every reply byte of the runs in
  * [prev published, executed). Prefetch is done by the caller window. */
+#ifdef STAGED_CHECKS
+/* STAGED_CHECKS builds: STREAM-path coverage, main only. execs: write steps that ran the streaming
+ * executor; multi: those with runs from two or more threads (S can differ from T); runs, entries:
+ * client runs and entries main executed there; cuts: runs that ended before the client's
+ * consecutive entries did (window cut), so the client continues in a later round. */
+static long long fp_chk_stream_execs, fp_chk_stream_multi, fp_chk_stream_runs, fp_chk_stream_entries,
+    fp_chk_stream_cuts;
+
+void fastpathCheckStreamInfo(sds *info) {
+    *info = sdscatprintf(*info,
+                         "staged_check_stream_execs:%lld\r\nstaged_check_stream_multi:%lld\r\n"
+                         "staged_check_stream_runs:%lld\r\nstaged_check_stream_entries:%lld\r\n"
+                         "staged_check_stream_cuts:%lld\r\n",
+                         fp_chk_stream_execs, fp_chk_stream_multi, fp_chk_stream_runs, fp_chk_stream_entries,
+                         fp_chk_stream_cuts);
+}
+
+void fastpathCheckStreamLog(void) {
+    serverLog(LL_NOTICE, "STAGED_CHECKS stream coverage: execs %lld multi %lld runs %lld entries %lld cuts %lld",
+              fp_chk_stream_execs, fp_chk_stream_multi, fp_chk_stream_runs, fp_chk_stream_entries, fp_chk_stream_cuts);
+}
+#endif
+
 static void fpStreamExecRun(client *ec, cmdBatch *b, fpStreamCursor *c, int max) {
     int from = c->ei;
     client *cl = b->e[from].c;
@@ -3172,6 +3198,11 @@ static void fpStreamExecRun(client *ec, cmdBatch *b, fpStreamCursor *c, int max)
         j++;
     }
     c->ei = j;
+#ifdef STAGED_CHECKS
+    fp_chk_stream_runs++;
+    fp_chk_stream_entries += j - from;
+    if (j < b->count && b->e[j].c == cl) fp_chk_stream_cuts++;
+#endif
 }
 
 /* True when the cursor sits at the start of a run (or the end of its batch). */
@@ -3265,6 +3296,10 @@ int fastpathStagedExecuteStreaming(void) {
         if (d == 0) fpWindowClose();
         return 0;
     }
+#ifdef STAGED_CHECKS
+    fp_chk_stream_execs++;
+    if (n >= 2) fp_chk_stream_multi++;
+#endif
 
     /* Entries main executes for one thread between publishes. */
     const int chunk = 16;
diff --git a/src/server.c b/src/server.c
index 6e9bdf41b..8b6ab265e 100644
--- a/src/server.c
+++ b/src/server.c
@@ -5545,6 +5545,9 @@ int finishShutdown(void) {
     bool nosave = (server.shutdown_flags & SHUTDOWN_NOSAVE) != 0;
     bool force = (server.shutdown_flags & SHUTDOWN_FORCE) != 0;
 
+#ifdef STAGED_CHECKS
+    fastpathCheckStreamLog();
+#endif
     /* Stop the replication stream sender before tearing replication down, so it
      * holds no reference to a replica or a backlog block when they are freed. */
     if (replStreamSenderActive()) replStreamSenderStop();
diff --git a/src/server.h b/src/server.h
index b67495614..d436fc807 100644
--- a/src/server.h
+++ b/src/server.h
@@ -756,6 +756,8 @@ typedef enum {
 #ifdef STAGED_CHECKS
 #define stagedCheck(...) serverAssert(__VA_ARGS__)
 int fastpathWindowOpen(void); /* fastpath.c: inside this iteration's empty window (4.7) */
+void fastpathCheckStreamInfo(sds *info); /* fastpath.c: STREAM-path coverage counters */
+void fastpathCheckStreamLog(void);
 #else
 #define stagedCheck(...) ((void)0)
 #endif
diff --git a/src/unit/test_fastpath_difftest.cpp b/src/unit/test_fastpath_difftest.cpp
index 95730ef98..424f1f638 100644
--- a/src/unit/test_fastpath_difftest.cpp
+++ b/src/unit/test_fastpath_difftest.cpp
@@ -240,11 +240,14 @@ class FastpathDifftest : public ::testing::Test {
         while ((n = ::recv(peer, buf, sizeof(buf), MSG_DONTWAIT)) > 0) out.append(buf, n);
     }
 
+    static inline bool dt_stream = false; /* MODE_STREAM*: the write step runs the STREAM executor */
+
     static void iteration() {
         fastpathStagedPrepareLanes();
         pollerGetNextBatch(stagedPoller(), 0);
         fastpathStagedReadPhase(1);
-        fastpathStagedExecute();
+        if (dt_stream) fastpathStagedExecuteStreaming();
+        else fastpathStagedExecute();
         if (fastpathStagedRepliesPending()) fastpathStagedReplyPhase(1);
         fastpathStagedFinish();
     }
@@ -422,6 +425,7 @@ class FastpathDifftest : public ::testing::Test {
         std::vector<std::string> replies; /* per client, all rounds */
         std::string dump;
         long long lane_phases, lane_entries, serial_segments, barriers, lane_prefetches;
+        long long stream_entries, stream_cuts; /* STAGED_CHECKS builds only; -1 delta otherwise */
     };
 
     /* Four executors for one stream: MODE_LANES runs every segment on the lanes with the lane key prefetch
@@ -430,15 +434,23 @@ class FastpathDifftest : public ::testing::Test {
      * segments and barriers but fpSerialSegment runs each segment's entries whole on main; MODE_PLAIN turns
      * lane planning off (io-threads-parallel-writes 0), so fastpathStagedExecute runs every batch in stream
      * order with no classification, segments or barriers: the executor the design had before the lanes. */
-    enum { MODE_LANES = 0, MODE_SERIAL = 1, MODE_PLAIN = 2, MODE_LANES_PREFETCH = 3 };
+    enum { MODE_LANES = 0, MODE_SERIAL = 1, MODE_PLAIN = 2, MODE_LANES_PREFETCH = 3, MODE_STREAM = 4, MODE_STREAM_CUT = 5 };
 
-    /* Run the scenario on an empty database with the given executor. */
+    /* Run the scenario on an empty database with the given executor. MODE_STREAM plans segments as the
+     * server does when no segment reaches the lane threshold, then runs the write step with the STREAM
+     * executor (fastpathStagedExecuteStreaming: one client run at a time, publishing at run boundaries);
+     * MODE_STREAM_CUT the same with prefetch-batch-max-size 2, so runs are cut and resume in a later
+     * round. With one IO thread the STREAM order S equals T, so the plain executor is the oracle. */
     static RunResult run(const Scenario &s, int mode) {
         RunResult res;
         emptyDbStructure(server.db, -1, 0, NULL);
+        dt_stream = mode == MODE_STREAM || mode == MODE_STREAM_CUT;
+        server.prefetch_batch_max_size = mode == MODE_STREAM_CUT ? 2 : 16;
         server.io_threads_parallel_writes = mode == MODE_PLAIN ? 0 : 1;
         server.io_threads_parallel_writes_min = (mode == MODE_LANES || mode == MODE_LANES_PREFETCH) ? 1 : 1000000;
         server.io_threads_lane_prefetch = mode == MODE_LANES_PREFETCH ? 1 : 0;
+        long long sentries0 = infoStat("staged_check_stream_entries");
+        long long scuts0 = infoStat("staged_check_stream_cuts");
         long long prefetches0 = infoStat("fastpath_write_lane_prefetches");
         long long phases0 = infoStat("fastpath_write_lane_phases");
         long long entries0 = infoStat("fastpath_write_lane_entries");
@@ -480,6 +492,8 @@ class FastpathDifftest : public ::testing::Test {
         res.serial_segments = infoStat("fastpath_write_serial_segments") - serial0;
         res.barriers = infoStat("fastpath_write_barriers") - barriers0;
         res.lane_prefetches = infoStat("fastpath_write_lane_prefetches") - prefetches0;
+        res.stream_entries = infoStat("staged_check_stream_entries") - sentries0;
+        res.stream_cuts = infoStat("staged_check_stream_cuts") - scuts0;
         close(dpeer);
         freeClient(dc);
         for (int c = 0; c < s.nclients; c++) {
@@ -491,6 +505,8 @@ class FastpathDifftest : public ::testing::Test {
         server.io_threads_parallel_writes = 1;
         server.io_threads_parallel_writes_min = 1;
         server.io_threads_lane_prefetch = 0;
+        server.prefetch_batch_max_size = 16;
+        dt_stream = false;
         return res;
     }
 
@@ -612,3 +628,41 @@ TEST_F(FastpathDifftest, SerialExecutorIsDeterministic) {
         for (int c = 0; c < s.nclients; c++) ASSERT_EQ(a.replies[c], b.replies[c]) << "seed " << seed << " client " << c;
     }
 }
+
+/* The STREAM executor (window 16 and window 2) gives the plain executor's bytes: every reply of every
+ * client and the final dataset. Checks that S keeps each client's program order and that a run cut by
+ * the window resumes at its cursor. In STAGED_CHECKS builds the STREAM path must have run every seed. */
+TEST_F(FastpathDifftest, StreamExecutorMatchesPlainOverRandomPrograms) {
+    uint64_t first = envNum("DIFFTEST_FIRST", 1);
+    uint64_t n = envNum("DIFFTEST_SEEDS", 2000);
+    int failed = 0;
+    long long entries = 0, cuts = 0;
+    for (uint64_t seed = first; seed < first + n; seed++) {
+        Scenario s = makeScenario(seed);
+        RunResult plain = run(s, MODE_PLAIN);
+        RunResult st = run(s, MODE_STREAM);
+        RunResult cut = run(s, MODE_STREAM_CUT);
+        bool ok = st.dump == plain.dump && cut.dump == plain.dump;
+        for (int c = 0; c < s.nclients && ok; c++)
+            ok = st.replies[c] == plain.replies[c] && cut.replies[c] == plain.replies[c];
+        if (!ok) {
+            std::string msg = showScenario(seed, s);
+            for (int c = 0; c < s.nclients; c++) {
+                msg += " c" + std::to_string(c) + " plain : " + printable(plain.replies[c]) + "\n";
+                msg += " c" + std::to_string(c) + " stream: " + printable(st.replies[c]) + "\n";
+                msg += " c" + std::to_string(c) + " cut   : " + printable(cut.replies[c]) + "\n";
+            }
+            ADD_FAILURE() << "the STREAM and plain executors differ\n" << msg;
+            if (++failed >= (int)envNum("DIFFTEST_MAXFAIL", 3)) break;
+        }
+#ifdef STAGED_CHECKS
+        EXPECT_GT(st.stream_entries, 0) << "seed " << seed << ": the STREAM run did not use the STREAM executor";
+        EXPECT_GT(cut.stream_entries, 0) << "seed " << seed;
+#endif
+        entries += st.stream_entries + cut.stream_entries;
+        cuts += cut.stream_cuts;
+    }
+    printf("STREAM difftest: seeds %llu, stream entries %lld, cut runs %lld, failed %d\n", (unsigned long long)n,
+           entries, cuts, failed);
+    EXPECT_EQ(failed, 0);
+}
-- 
2.50.1

