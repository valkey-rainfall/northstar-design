+++ b/src/fastpath.c
@@ -222,9 +222,14 @@ int fastpathWindowOpen(void) {
     return fp_window_open;
 }
 
-void fastpathWindowClose(void) {
+/* Main, when the write step's batch execution ends: main-path clients and the cluster bus may run
