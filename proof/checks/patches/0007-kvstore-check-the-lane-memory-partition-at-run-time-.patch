diff --git a/src/kvstore.c b/src/kvstore.c
index ea59b5a67..f203b2c55 100644
--- a/src/kvstore.c
+++ b/src/kvstore.c
@@ -147,13 +147,38 @@ hashtableType intHashtableType = {.instant_rehashing = 1};
 /*** Helpers **********************/
 /**********************************/
 
+#ifdef STAGED_CHECKS
+/* The thread's claim on the tables of kvstores in concurrent mode (kvstore.h). */
+static _Thread_local int kvs_owned_mod = 0, kvs_owned_lane = -1, kvs_owned_only = -1;
+
+void kvstoreOwnTables(int mod, int lane) {
+    kvs_owned_mod = mod;
+    kvs_owned_lane = lane;
+}
+
+void kvstoreOwnTable(int didx) {
+    kvs_owned_only = didx;
+}
+
+/* Every access to a table goes through here. The memory partition of the lane phase: a table of a
+ * kvstore in concurrent mode is touched only by the thread that owns it. */
+static inline void kvstoreCheckOwned(kvstore *kvs, int didx) {
+    if (!kvstoreConcurrent(kvs)) return;
+    assert((kvs_owned_mod > 0 && didx % kvs_owned_mod == kvs_owned_lane) || didx == kvs_owned_only);
+}
+#else
+#define kvstoreCheckOwned(kvs, didx) ((void)0)
+#endif
+
 /* Get the hash table pointer based on hashtable-index.
  * May be NULL if no keys have been added. */
 hashtable *kvstoreGetHashtable(kvstore *kvs, int didx) {
+    kvstoreCheckOwned(kvs, didx);
     return kvs->hashtables[didx];
 }
 
 static hashtable **kvstoreGetHashtableRef(kvstore *kvs, int didx) {
+    kvstoreCheckOwned(kvs, didx);
     return &kvs->hashtables[didx];
 }
 
@@ -789,6 +814,7 @@ static hashtable *kvstoreIteratorNextHashtable(kvstoreIterator *kvs_it) {
     if (kvs_it->next_didx != KVSTORE_INDEX_NOT_FOUND) {
         kvs_it->next_didx = kvstoreGetNextNonEmptyHashtableIndex(kvs_it->kvs, kvs_it->didx);
     }
+    kvstoreCheckOwned(kvs_it->kvs, kvs_it->didx);
     return kvs_it->kvs->hashtables[kvs_it->didx];
 }
 
diff --git a/src/kvstore.h b/src/kvstore.h
index 18609954f..e14737a51 100644
--- a/src/kvstore.h
+++ b/src/kvstore.h
@@ -22,6 +22,19 @@ typedef void (*kvstoreScanFunction)(void *privdata, void *entry, int didx);
 /* Main, outside lane phases: let threads mutate distinct hashtables of kvs concurrently (on), or end
  * that after the threads joined (off), then call kvstoreReconcile. Other kvstores are unaffected. */
 void kvstoreSetConcurrent(kvstore *kvs, int on);
+/* STAGED_CHECKS builds: while a kvstore is in concurrent mode, a thread may touch only the tables it
+ * claimed for the phase: every table with didx % mod == lane (a write or apply lane), or one table
+ * (a MAINT unit). mod 0 or didx -1 releases the claim. Any other access, by a lane, by main or by an
+ * IO thread's inbox job, is a memory-partition violation and asserts. Absent from other builds. */
+#ifdef STAGED_CHECKS
+void kvstoreOwnTables(int mod, int lane);
+void kvstoreOwnTable(int didx);
+#define KVSTORE_OWN_TABLES(mod, lane) kvstoreOwnTables(mod, lane)
+#define KVSTORE_OWN_TABLE(didx) kvstoreOwnTable(didx)
+#else
+#define KVSTORE_OWN_TABLES(mod, lane) ((void)0)
+#define KVSTORE_OWN_TABLE(didx) ((void)0)
+#endif
 kvstore *kvstoreCreate(hashtableType *type, int num_hashtables_bits, int flags);
 void kvstoreEmpty(kvstore *kvs, void(callback)(hashtable *));
 void kvstoreRelease(kvstore *kvs);
