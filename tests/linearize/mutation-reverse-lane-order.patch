diff --git a/src/fastpath.c b/src/fastpath.c
index eb3df1b5..6e125e4e 100644
--- a/src/fastpath.c
+++ b/src/fastpath.c
@@ -2093,12 +2093,13 @@ void fastpathStagedWriteLane(int tid) {
         uint32_t s = fp_parts[p].seg;
         fpThread *th = &fp_threads[t];
         int *cur = &L->cursor[t];
-        while (*cur < th->lane_n[lane]) {
-            cmdEntry *e = th->lane_ents[lane][*cur];
-            if (e->seg > s) break;
