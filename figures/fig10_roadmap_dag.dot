digraph roadmap {
  rankdir=LR; splines=spline; nodesep=0.3; ranksep=0.8;
  node [shape=box, fontname="DejaVu Sans", fontsize=10.5, margin="0.22,0.10"];
  s1 [label="1. Flags word split\n+ sanitizer job"];
  s2 [label="2. Keyspace partitions"];
  s3 [label="3. Basic phased loop"];
  s4 [label="4. Collector thread\n+ STREAM phase"];
  s5 [label="5. ACL evaluation\non IO threads"];
  s6 [label="6. Fast reads"];
  s7 [label="7. Replication throttling\n+ phased loop"];
  s8 [label="8. Write lanes\non a primary"];
  s9 [label="9. Parallel apply\non a replica"];
  s10 [label="10. Parallel table\nmaintenance"];
  s11 [label="11. Later options"];
  s1 -> s3;
  s3 -> s4;
  s3 -> s6;
  s5 -> s6;
  s3 -> s7;
  s2 -> s8;
  s3 -> s8;
  s8 -> s9;
  s2 -> s10;
  s3 -> s10;
  s7 -> s8 [style=dashed];
  { rank=same; s1; }
  { rank=same; s3; }
  { rank=same; s5; s2; s4; s7; }
  { rank=same; s6; s10; s8; }
  { rank=same; s9; }
  { rank=same; s11; }
  s5 -> s2 [style=invis];
  s2 -> s4 [style=invis];
  s4 -> s7 [style=invis];
  s6 -> s10 [style=invis];
  s10 -> s8 [style=invis];
  s9 -> s11 [style=invis];
}
